{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sol",
  "compatibility_date": "2026-07-31",
  "main": "./worker/index.js",
  "routes": [
    {
      "pattern": "desorden.cat/*",
      "zone_name": "desorden.cat"
    },
    {
      "pattern": "www.desorden.cat/*",
      "zone_name": "desorden.cat"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/sat/*"
    ]
  }
}
